# ──────────────────────────────────────────────────────────────────────────────
# .env.example – copy this file to .env and fill in your values.
#
# The .env file is loaded automatically by locustfile.py when running locally.
# It is intentionally excluded from version control (see .gitignore).
# Do NOT commit real values to source control.
# ──────────────────────────────────────────────────────────────────────────────

# Locust runtime settings
LOCUST_USERS=200
LOCUST_SPAWN_RATE=3
LOCUST_RUN_TIME=120

# Full URL of your Azure AI Search service.
# Example: https://mysearch.search.windows.net
SEARCH_ENDPOINT=https://<your-service>.search.windows.net

# Name of the target knowledge base for Agentic Retrieval.
KNOWLEDGE_BASE_NAME=your-knowledge-base
